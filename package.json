{
  "name": "html-editor",
  "version": "2.0.0",
  "description": "UPI Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "keywords": [],
  "author": "Mark Bolden",
  "license": "ISC",
  "devDependencies": {
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.stream.upi",
    "productName": "UPI",
    "artifactName": "UPI-Setup-${version}.${ext}",
    "executableName": "UPI",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "executableName": "UPI",
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UPI",
      "runAfterFinish": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico"
    }
  }
}
